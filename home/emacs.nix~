{
  programs.emacs.enable = true;
  programs.emacs.extraConfig = ''
    (require 'package)
    (setq package-enable-at-startup nil)
    (require 'use-package)
    (setq use-package-always-ensure nil)

    (use-package magit
      :bind (("C-x g" . magit-status))
      :config
      (setq-magit-display-buffer-function #'magit-display-buffer-fullframe-status))

    (setq inhibit-startup-message t)
    (tool-bar-mode -1)
    (menu-bar-mode -1)
    (scroll-bar-mode -1)
  '';

  services.emacs = {
    enable = true;
    client = {
      enable = true;
      arguments = [ "-c" "-a ''" ];
    };
    startWithUserSession = true;
  };
}
